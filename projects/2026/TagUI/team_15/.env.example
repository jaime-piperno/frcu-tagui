# Crear el archivo .env copiando este archivo a .env y completar los valores.
# TELEGRAM_TOKEN: obtenelo de @BotFather en Telegram (/newbot)
TELEGRAM_TOKEN=

# OPENROUTER_API_KEY: (recomendado) creala gratis en https://openrouter.ai/keys
# Debe ser la key COMPLETA (empieza con sk-or-v1-). Si está incompleta el
# bot no va a poder interpretar los gastos.
OPENROUTER_API_KEY=

# OPENROUTER_MODELO: modelo en OpenRouter (opcional)
#OPENROUTER_MODELO=meta-llama/llama-3.3-70b-instruct:free

# GEMINI_API_KEY: alternativa a OpenRouter. Obtenela en
# https://aistudio.google.com/apikey (empieza con AIza...). Actualmente la
# key del proyecto está denegada (403), por eso se recomienda OpenRouter.
GEMINI_API_KEY=

# LLM_MODELO: modelo Gemini a usar (opcional, por defecto gemini-3.6-flash)
#LLM_MODELO=gemini-3.6-flash

# GOOGLE_SHEET_ID: ID de la hoja de Google Sheets (parte de la URL entre /d/ y /edit)
# credentials.json (Service Account) debe estar en la carpeta del proyecto.
GOOGLE_SHEET_ID=