# Credenciales y Configuración del Bot de Telegram (Grupo 12 RPA)
# Copia este archivo como .env en esta misma carpeta y completa los valores.

# Token HTTP obtenido de @BotFather (Ejemplo: 1234567890:ABCdefGhIJKlmNoPQRsTUVwxyZ)
TELEGRAM_BOT_TOKEN=""

# ID del chat personal, grupo o canal destino (Ejemplo: 123456789 o -1001234567890)
TELEGRAM_CHAT_ID=""

# Activar o desactivar notificaciones (true/false)
TELEGRAM_NOTIFY_ENABLED="true"

# Timeout en segundos para la conexión con la API de Telegram
TELEGRAM_TIMEOUT_SECONDS="10"
